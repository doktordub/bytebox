      {
        "method": "POST",
        "path": "/memories/export"
      },
      {
        "method": "POST",
        "path": "/memories/import"
      },
      {
        "method": "POST",
        "path": "/memories/delete-by-scope"
      },
      {
        "method": "GET",
        "path": "/health"
      },
      {
        "method": "GET",
        "path": "/stats"
      }
    ]
  },
