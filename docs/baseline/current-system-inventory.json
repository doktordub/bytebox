        "export_user_memories",
        "export_scope",
        "import_memories",
        "redact",
        "add_feedback"
      ],
      "operations": [
        "stats",
        "health"
      ]
    }
  },
  "cli": {
    "name": "memory-store",
    "common_options": [
      "--config"
    ],
    "commands": [
      "health",
      "init",
      "ingest-file",
      "ingest-folder",
      "unlock",
      "search",
      "search-chunks",
      "chunk-context",
      "eval",
      "export",
      "delete-by-scope"
    ]
  },
  "config": {
    "example_file": "config.example.yaml",
    "env_prefix": "MEMORY_STORE_",
    "precedence": [
      "defaults",
      "yaml",
      "environment",
      "explicit_overrides"
    ],
